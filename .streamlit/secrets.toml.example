# Konfigurasi Marine BI Analytics
# Setara dengan connection string SSMS:
#   Data Source=.\SQLEXPRESS;Integrated Security=True;Encrypt=True;TrustServerCertificate=True

[database]
server = '.\SQLEXPRESS'                # "." = komputer ini (jauh lebih cepat dari localhost)
database = "COPY_DATA"
driver = "auto"                        # atau "ODBC Driver 18 for SQL Server"
trusted_connection = true              # Windows Authentication (Integrated Security)
username = ""                          # isi hanya jika trusted_connection = false
password = ""
encrypt = true
trust_server_certificate = true

source_schema = "dbo"
source_noon_table = "NOON_REPORT_COPY"
source_voyage_table = "V_Voyages"
source_vessel_table = "vessels"
use_nolock = true
dw_schema = "dw"

[analytics]
egt_valid_min = 100.0
egt_valid_max = 600.0
min_valid_cylinders = 4                # minimal silinder valid per laporan
baseline_mode = "rpm_bin"              # sesuai proposal: baseline per rentang RPM
rpm_bin_width = 10.0                   # lebar rentang RPM (90-100, 100-110, ...)
baseline_window = 60                   # maksimal data historis di baseline
min_baseline_obs = 10                  # minimal data historis agar bisa dihitung
z_threshold = 3.5                      # ANOMALY jika |Modified Z-Score| > 3.5
drop_uninstalled_cylinders = true      # sembunyikan CYL7-8 pada mesin 6 silinder
only_active_reports = true             # hanya laporan IS_ACTIVE = 1
egt_requires_rpm = true                # EGT tidak valid jika RPM = 0
speed_column = "SPEED_OVER_GROUND"     # AVG_SPEED di data sumber hampir selalu 0

[forecast]
horizon = 3                            # ramalan berapa bulan ke depan
test_months = 3                        # bulan terakhir untuk menghitung MAPE
min_reports_per_month = 15             # bulan dengan laporan valid lebih sedikit tidak dipakai
fuel_valid_max = 100.0                 # konsumsi > 100 MT per laporan dianggap salah input

[app]
default_window_days = 30
cache_ttl_seconds = 600
max_table_rows = 5000
[auto_etl]
enabled = true                         # ETL incremental otomatis saat NOON_REPORT_COPY ada data baru
interval_seconds = 60                  # cek setiap 60 detik
